# ============================================================================
# OPEN-TERMINAL :: credentials  (copy to `.env` and fill in what you want)
#
# EVERY key here is optional and free. The terminal runs without any of them:
#   FRED    falls back to its keyless CSV endpoint (fully functional)
#   OpenSky falls back to anonymous access (400 credits/day instead of 4000)
#   AIS     is the one module that genuinely needs a key to do anything
# ============================================================================

# --- Macro ------------------------------------------------------------------
# https://fredaccount.stlouisfed.org/apikeys   (instant, email only)
FRED_API_KEY=

# --- Aviation ---------------------------------------------------------------
# https://opensky-network.org  -> register -> Account -> API Client
# NOTE: OpenSky moved to OAuth2. Username/password no longer works.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- Maritime ---------------------------------------------------------------
# https://aisstream.io  (free key, global AIS websocket firehose)
AISSTREAM_API_KEY=

# --- SEC EDGAR --------------------------------------------------------------
# SEC's fair-access policy REQUIRES a descriptive User-Agent with real contact
# info. Requests without one get 403'd and repeat offenders are IP-banned.
# Put your own email here.
SEC_USER_AGENT=Open-Terminal/1.0 (research; your.email@example.com)

# --- Local AIS receiver (optional, best quality) -----------------------------
# If you run an RTL-SDR with rtl_ais / AISdispatcher, point us at its UDP feed.
#   rtl_ais -n -h 127.0.0.1 -P 10110
AIS_UDP_HOST=0.0.0.0
AIS_UDP_PORT=10110

# --- Runtime flags -----------------------------------------------------------
# Full tracebacks in the UI + debug logging.
OPENTERM_DEBUG=0

# Render entirely from cache, make zero network calls.
OPENTERM_OFFLINE=0

# Enable the MarineTraffic / VesselFinder Playwright scrapers.
# READ FIRST: both sites prohibit automated collection in their Terms of
# Service and sit behind Cloudflare. These paths are brittle by design and
# ship disabled. Turning them on is your decision, not the default.
OPENTERM_ALLOW_SCRAPERS=0
